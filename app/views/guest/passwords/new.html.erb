<% content_for :title, t(".title") %>

<div class="w-full max-w-sm">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-semibold"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-base-content/60 text-pretty"><%= t(".subheading") %></p>
  </div>

  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <%= form_with model: @form, url: passwords_path, class: "flex flex-col gap-4" do |form| %>
        <fieldset class="fieldset">
          <%= form.label :email, t(".email"), class: "fieldset-legend pt-0" %>
          <label class="input validator w-full">
            <%= render "shared/icons/envelope" %>
            <%= form.email_field :email, placeholder: t(".email_placeholder"), autocomplete: "username", required: true, autofocus: true %>
          </label>
          <%= render "shared/field_error", form: form, attribute: :email, hint: t(".email_hint") %>
        </fieldset>

        <%= form.submit t(".submit"), class: "btn btn-primary w-full",
                        data: { turbo_submits_with: t("shared.submitting.sending") } %>
      <% end %>
    </div>
  </div>

  <p class="mt-6 text-center text-sm">
    <%= link_to new_session_path, class: "link link-hover inline-flex items-center gap-1 text-base-content/60" do %>
      <%= render "shared/icons/chevron_left" %> <%= t(".back") %>
    <% end %>
  </p>
</div>
