<% content_for :title, t(".title") %>

<div class="w-full max-w-sm">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-semibold"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-base-content/60"><%= t(".subheading", count: Rails.configuration.x.validations.password_length.min) %></p>
  </div>

  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <%= form_with model: @form, url: password_path(params[:token]), method: :patch, class: "flex flex-col gap-4" do |form| %>
        <% if @form.errors[:base].any? %>
          <div role="alert" class="alert alert-error alert-soft">
            <%= render "shared/icons/x_circle" %>
            <span><%= @form.errors[:base].to_sentence %></span>
          </div>
        <% end %>

        <fieldset class="fieldset">
          <%= form.label :password, t(".password"), class: "fieldset-legend pt-0" %>
          <label class="input validator w-full">
            <%= render "shared/icons/lock_closed" %>
            <%= form.password_field :password, autocomplete: "new-password", minlength: Rails.configuration.x.validations.password_length.min, required: true, autofocus: true %>
          </label>
          <%= render "shared/field_error", form: form, attribute: :password, hint: t(".password_hint", count: Rails.configuration.x.validations.password_length.min) %>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :password_confirmation, t(".password_confirmation"), class: "fieldset-legend pt-0" %>
          <label class="input validator w-full">
            <%= render "shared/icons/lock_closed" %>
            <%= form.password_field :password_confirmation, autocomplete: "new-password", minlength: Rails.configuration.x.validations.password_length.min, required: true %>
          </label>
          <%= render "shared/field_error", form: form, attribute: :password_confirmation, hint: t(".password_hint", count: Rails.configuration.x.validations.password_length.min) %>
        </fieldset>

        <%= form.submit t(".submit"), class: "btn btn-primary w-full",
                        data: { turbo_submits_with: t("shared.submitting.saving") } %>
      <% end %>
    </div>
  </div>
</div>
