<% content_for :title, t(".title") %>

<div class="w-full max-w-sm">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-semibold"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-base-content/60"><%= t(".subheading") %></p>
  </div>

  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <% if @form.errors.any? %>
        <div role="alert" class="alert alert-error alert-soft">
          <%= render "shared/icons/x_circle" %>
          <span><%= @form.errors.full_messages.to_sentence %></span>
        </div>
      <% end %>

      <%= form_with model: @form, url: session_path, class: "flex flex-col gap-4" do |form| %>
        <fieldset class="fieldset">
          <%= form.label :email, t(".email"), class: "fieldset-legend pt-0" %>
          <label class="input validator w-full">
            <%= render "shared/icons/envelope" %>
            <%= form.email_field :email, placeholder: t(".email_placeholder"), autocomplete: "username", required: true, autofocus: true %>
          </label>
          <p class="validator-hint hidden"><%= t(".email_hint") %></p>
        </fieldset>

        <fieldset class="fieldset">
          <div class="flex items-center justify-between">
            <%= form.label :password, t(".password"), class: "fieldset-legend pt-0" %>
            <%= link_to t(".forgot_password"), new_password_path, class: "link link-hover link-primary text-xs" %>
          </div>
          <label class="input validator w-full">
            <%= render "shared/icons/lock_closed" %>
            <%= form.password_field :password, placeholder: "••••••••", autocomplete: "current-password", required: true %>
          </label>
          <p class="validator-hint hidden"><%= t(".password_hint") %></p>
        </fieldset>

        <%= form.submit t(".submit"), class: "btn btn-primary w-full",
                        data: { turbo_submits_with: t("shared.submitting.signing_in") } %>
      <% end %>
    </div>
  </div>

  <p class="mt-6 text-center text-sm text-base-content/60">
    <%= t(".no_account") %>
    <%= link_to t(".sign_up"), new_registration_path, class: "link link-hover link-primary font-medium" %>
  </p>
</div>
