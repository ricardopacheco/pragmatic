<li id="<%= session.dom_id %>" class="flex items-center gap-3 py-3">
  <div class="grid size-9 shrink-0 place-items-center rounded-field bg-base-200 text-lg text-base-content/60">
    <%= render "shared/icons/shield_check" %>
  </div>
  <div class="min-w-0 flex-1">
    <p class="truncate text-sm font-medium"><%= session.browser %></p>
    <p class="truncate text-sm text-base-content/60"><%= session.ip_address %> · <%= session.started_at %></p>
  </div>

  <% if session.current? %>
    <span class="badge badge-soft badge-success"><%= t("profile.profiles.show.sessions.current") %></span>
  <% end %>
</li>
