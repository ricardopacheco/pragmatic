<section id="<%= import.dom_id %>_progress" class="card border border-error/30 bg-base-100 shadow-sm">
  <div class="card-body gap-4 sm:flex-row sm:items-start">
    <div class="grid size-10 shrink-0 place-items-center rounded-full bg-error/10 text-xl text-error">
      <%= render "shared/icons/exclamation_triangle" %>
    </div>
    <div class="flex-1">
      <h2 class="font-semibold"><%= t(".heading") %></h2>
      <p class="mt-1 text-sm text-base-content/70 text-pretty"><%= import.failure_reason %></p>
      <ul class="mt-3 list-inside list-disc text-sm text-base-content/60">
        <li><%= t(".formats") %></li>
        <li><%= t(".headers", headers: SpreadsheetReader::Base::KNOWN_HEADERS.join(", ")) %></li>
      </ul>
    </div>
  </div>
  <div class="flex border-t border-base-300 px-6 py-4 sm:justify-end">
    <%= link_to admin_imports_path, class: "btn btn-primary" do %>
      <%= render "shared/icons/arrow_up_tray" %> <%= t(".retry") %>
    <% end %>
  </div>
</section>
